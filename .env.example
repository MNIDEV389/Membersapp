# ─── Required ────────────────────────────────────────────────────────────────
# Long random string (min 32 chars). Generate with: openssl rand -base64 48
PAYLOAD_SECRET=

# Public URL of this app (no trailing slash). Used for cookies, CSRF and CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
#  - Production (Supabase): use the *pooled* Postgres connection string
#      postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#  - Local development: leave empty to use a local SQLite file (./mni-dev.db)
DATABASE_URI=

# ─── Optional: comma-separated extra origins allowed to call the API ─────────
# e.g. the separate MNI Admin app, or the Capacitor mobile shell
ALLOWED_ORIGINS=

# ─── Optional: S3-compatible storage for uploads (Supabase Storage works) ────
# When unset, uploads are stored on local disk in ./media (dev only).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Seeding (pnpm seed) — local/staging only ────────────────────────────────
SEED_ADMIN_EMAIL=admin@mni.network
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
